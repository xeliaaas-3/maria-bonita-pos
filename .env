# ============================================
# BOUTIQUE POS - Variables de Entorno
# ============================================

# App
NODE_ENV=production
PORT=4000
BASE_URL=http://backend:4000
APP_NAME="Maria Bonita"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DB_USER=boutique
DB_PASSWORD=boutique123_CHANGE_ME
DB_NAME=boutique_pos
DATABASE_URL=postgresql://boutique:boutique123_CHANGE_ME@postgres:5432/boutique_pos

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://redis:6379

# Email (para recuperación de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=tu_app_password
SMTP_FROM="Boutique POS <noreply@boutique.com>"

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Backup
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Empresa (defaults, se pueden cambiar desde config)
COMPANY_NAME="Maria Bonita"
COMPANY_CURRENCY=PYG
COMPANY_TIMEZONE=America/Asuncion
